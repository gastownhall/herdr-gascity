{
  "name": "herdr-gascity",
  "version": "0.0.0",
  "private": true,
  "description": "Gas City inside the Herdr desktop app: a herdr-app mod that shows a city's rigs, agents and work and acts on them through gc's API.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun run build.ts",
    "check:bundle": "bun run scripts/bundle-fresh.ts",
    "lint:authority": "bun run scripts/authority.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "test": "bun test",
    "ci": "bun run typecheck && bun run lint:authority && bun run check:bundle && bun test",
    "gen:gc": "bun run scripts/gen-gc.ts",
    "pin:gc": "bun run scripts/pin-gc-spec.ts",
    "record:gc": "bun run test/contract/record.ts",
    "notices": "bun run scripts/notices.ts",
    "package": "bun run scripts/package.ts",
    "test:integration": "bun test --timeout 300000 ./test/integration/scenario.integration.ts"
  },
  "devDependencies": {
    "@jitl/quickjs-ng-wasmfile-release-sync": "0.32.0",
    "@types/bun": "1.4.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "quickjs-emscripten-core": "0.32.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
