{
  "$comment": "The part of gc's API this mod uses. scripts/pin-gc-spec.ts prunes the pinned spec to these operations; scripts/gen-gc.ts generates types and zod schemas for exactly these models and fields. A model reached from an operation must be listed here; a listed field must exist in the pin. Only object schemas are listed; scalar schemas (enums) are inlined. Response models are decoded at run time; request models are TypeScript types only. payloadModels are decoded at run time from an untyped field (RequestFailedPayload is the payload of a request.failed event inside RequestOutcome.event; BeadEventPayload is the payload of bead.created/updated/closed/deleted events).",
  "operations": {
    "get-health": "liveness, version and build id for compatibility checks",
    "get-v0-cities": "city list with running/status",
    "get-v0-city-by-city-name-rigs": "rigs panel",
    "get-v0-city-by-city-name-agents": "agents panel",
    "get-v0-city-by-city-name-sessions": "sessions with program_status, active bead, attached, transport (cursor pages; wake_reasons on detail open only)",
    "get-v0-city-by-city-name-session-by-id": "session detail with peek output; wake-before-attach polling",
    "get-v0-city-by-city-name-pending": "city-wide pending interactions (needs-you badges)",
    "get-v0-city-by-city-name-session-by-id-pending": "a session's pending prompt and its options",
    "get-v0-city-by-city-name-work-ready": "work board columns and the bounded closed seed",
    "get-v0-city-by-city-name-bead-by-id": "targeted bead refetch and active-bead titles",
    "get-v0-city-by-city-name-events": "short non-blocking change-signal poll (no index)",
    "get-request-outcome": "outcome of 202 requests (session create/submit/message)",
    "create-session": "start a session",
    "submit-session": "send input to a session",
    "send-session-message": "send a message to a session",
    "respond-session": "answer a pending prompt",
    "post-v0-city-by-city-name-session-by-id-wake": "wake a session (also before opening its terminal)",
    "post-v0-city-by-city-name-session-by-id-suspend": "suspend a session",
    "post-v0-city-by-city-name-session-by-id-stop": "stop the current turn",
    "post-v0-city-by-city-name-session-by-id-close": "close a session",
    "post-v0-city-by-city-name-session-by-id-kill": "kill a session",
    "post-v0-city-by-city-name-session-by-id-pin": "pin a session awake",
    "post-v0-city-by-city-name-session-by-id-unpin": "unpin a session",
    "post-v0-city-by-city-name-agent-by-base-by-action": "suspend/resume a city-scoped agent",
    "post-v0-city-by-city-name-agent-by-dir-by-base-by-action": "suspend/resume a rig-scoped agent",
    "post-v0-city-by-city-name-rig-by-name-by-action": "suspend/resume/restart a rig",
    "post-v0-city-by-city-name-sling": "route a bead to an agent",
    "create-bead": "create a bead",
    "post-v0-city-by-city-name-bead-by-id-close": "close a bead",
    "post-v0-city-by-city-name-bead-by-id-reopen": "reopen a bead"
  },
  "models": {
    "ErrorModel": { "fields": ["type", "title", "status", "detail", "instance", "code", "errors"] },
    "ErrorDetail": { "fields": ["location", "message", "value"] },

    "SupervisorHealthOutputBody": { "fields": ["status", "version", "build_id", "uptime_sec", "cities_total", "cities_running", "startup"] },
    "SupervisorStartup": { "fields": ["ready", "phase", "phases_completed"] },
    "SupervisorCitiesOutputBody": { "fields": ["items", "total"], "itemLevel": "items" },
    "CityInfo": { "fields": ["name", "path", "running", "status", "error"] },

    "ListBodyRigResponse": { "fields": ["items", "total", "next_cursor", "partial", "partial_errors"], "itemLevel": "items" },
    "RigResponse": { "fields": ["name", "path", "prefix", "suspended", "agent_count", "running_count", "default_sling_target"] },

    "ListBodyAgentResponse": { "fields": ["items", "total", "next_cursor", "partial", "partial_errors"], "itemLevel": "items" },
    "AgentResponse": { "fields": ["name", "display_name", "description", "rig", "pool", "pool_limits", "state", "suspended", "running", "available", "unavailable_reason", "active_bead", "activity", "activity_source", "program_status", "provider", "session"] },
    "PoolLimits": { "fields": ["min", "max"] },
    "SessionInfo": { "fields": ["name", "attached", "last_activity"] },

    "ListBodySessionResponse": { "fields": ["items", "total", "next_cursor", "partial", "partial_errors"], "itemLevel": "items" },
    "SessionResponse": { "fields": ["id", "alias", "title", "display_name", "template", "agent_name", "session_name", "rig", "pool", "kind", "provider", "transport", "state", "reason", "running", "attached", "active_bead", "activity", "activity_source", "program_status", "submission_capabilities", "created_at", "last_active", "last_output", "wake_reasons"], "keepAbsent": ["wake_reasons"] },
    "SessionProgramStatus": { "fields": ["state", "kind", "progress", "app", "since", "quiet_since", "working_children"] },
    "SubmissionCapabilities": { "fields": ["supports_follow_up", "supports_interrupt_now", "supports_steer"] },

    "ListBodyCityPendingEntry": { "fields": ["items", "total", "next_cursor", "partial", "partial_errors"], "itemLevel": "items" },
    "CityPendingEntry": { "fields": ["session_id", "request_id", "kind"] },
    "SessionPendingResponse": { "fields": ["supported", "pending"] },
    "PendingInteraction": { "fields": ["request_id", "kind", "prompt", "options", "metadata"] },

    "WorkReadyBody": { "fields": ["items"], "itemLevel": "items" },
    "ReadyBead": { "fields": ["id", "title", "status", "issue_type", "priority", "assignee", "labels", "created_at", "updated_at", "close_reason", "is_blocked"] },
    "Bead": { "fields": ["id", "title", "status", "issue_type", "priority", "assignee", "labels", "description", "created_at", "updated_at", "close_reason"] },

    "ListBodyWireEvent": { "fields": ["items", "total", "next_cursor", "partial", "partial_errors"], "itemLevel": "items" },
    "TypedEventStreamEnvelope": { "fields": ["seq", "type", "ts", "actor", "subject", "payload"] },

    "RequestOutcome": { "fields": ["request_id", "operation", "state", "event"] },
    "RequestFailedPayload": { "fields": ["request_id", "operation", "error_code", "error_message", "session_id"] },
    "BeadEventPayload": { "fields": ["bead"] },
    "AsyncAcceptedBody": { "fields": ["request_id", "status", "event_cursor", "idempotency_key", "replayed"] },
    "SessionCommandStatusBody": { "fields": ["status", "idempotency_key", "replayed"] },
    "OKResponseBody": { "fields": ["status"] },
    "OKWithIDResponseBody": { "fields": ["status", "id", "idempotency_key", "replayed"] },
    "SessionRespondOutputBody": { "fields": ["id", "status", "idempotency_key", "replayed"] },
    "RigActionBody": { "fields": ["rig", "action", "status", "failed", "killed"] },
    "SlingResponse": { "fields": ["status", "target", "bead", "root_bead_id", "workflow_id", "convoy_id", "dashboard_url", "warnings"] },

    "SessionCreateBody": { "fields": ["kind", "name", "alias", "title", "message", "async"] },
    "SessionSubmitInputBody": { "fields": ["message", "intent"] },
    "SessionMessageInputBody": { "fields": ["message"] },
    "SessionRespondInputBody": { "fields": ["action", "request_id", "text"] },
    "SessionStopBody": { "fields": ["turn"] },
    "SlingInputBody": { "fields": ["target", "bead"] },
    "BeadCreateInputBody": { "fields": ["title", "description", "priority", "labels", "type", "rig", "assignee"] },
    "BeadCloseBody": { "fields": ["reason"] }
  },
  "payloadModels": ["RequestFailedPayload", "BeadEventPayload"]
}
